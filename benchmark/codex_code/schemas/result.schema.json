{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lint-ai.dev/schemas/codex-code-result.schema.json",
  "title": "Lint-AI Codex performance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "arm",
    "repetition",
    "environment",
    "success",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "arm": { "enum": ["baseline", "lint-ai", "oracle"] },
    "repetition": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_version", "model", "lint_ai_revision", "fixture_revision"],
      "properties": {
        "codex_version": { "type": "string" },
        "model": { "type": "string" },
        "lint_ai_revision": { "type": "string" },
        "fixture_revision": { "type": "string" },
        "fixture_diff_digest": { "type": ["string", "null"] }
      }
    },
    "success": { "type": "boolean" },
    "invalid_reason": { "type": ["string", "null"] },
    "expected_fact_ids_found": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "forbidden_fact_ids_found": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_ms",
        "parent_tokens",
        "all_model_tokens",
        "subagent_tokens",
        "subagent_count",
        "delegations",
        "tool_calls",
        "injected_context_bytes",
        "exact_revision_memories"
      ],
      "properties": {
        "wall_clock_ms": { "type": "number", "minimum": 0 },
        "time_to_first_response_ms": { "type": ["number", "null"], "minimum": 0 },
        "parent_tokens": { "$ref": "#/$defs/tokenUsage" },
        "all_model_tokens": { "$ref": "#/$defs/tokenUsage" },
        "subagent_tokens": {
          "oneOf": [
            { "$ref": "#/$defs/tokenUsage" },
            { "type": "null" }
          ]
        },
        "unattributed_non_parent_tokens": {
          "oneOf": [
            { "$ref": "#/$defs/tokenUsage" },
            { "type": "null" }
          ]
        },
        "subagent_count": { "type": "integer", "minimum": 0 },
        "delegations": {
          "type": "array",
          "items": { "$ref": "#/$defs/delegation" }
        },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "repeated_tool_calls": { "type": "integer", "minimum": 0 },
        "injected_context_bytes": { "type": "integer", "minimum": 0 },
        "retrieved_documents": { "type": "integer", "minimum": 0 },
        "exact_revision_memories": { "type": "integer", "minimum": 0 },
        "selected_segments": { "type": "integer", "minimum": 0 },
        "hook_latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "hook_events": { "type": "integer", "minimum": 0 },
        "unknown_events": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens",
        "total"
      ],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_creation_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_use_id",
        "agent_id",
        "subagent_type",
        "purpose",
        "resolved_model",
        "prompt_sha256"
      ],
      "properties": {
        "tool_use_id": { "type": "string" },
        "agent_id": { "type": ["string", "null"] },
        "subagent_type": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] },
        "resolved_model": { "type": ["string", "null"] },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
